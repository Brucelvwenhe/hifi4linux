#!/bin/bash
# ============================================================
#  音乐库播放器 —— 启动器
#  先拉起后端 musicd.py，再启动 QML 界面
# ============================================================
set -u

BACKEND=""
FRONTEND=""
# 后端与界面可能来自两种安装方式，按「本地优先」逐个探测：
#   install.sh → ~/.local/bin/musicd.py        + ~/.local/share/musicplayer/main.qml
#   AUR 包     → /usr/lib/hifi4linux/musicd.py + /usr/share/hifi4linux/main.qml
for c in "$HOME/.local/bin/musicd.py" /usr/lib/hifi4linux/musicd.py; do
    [ -r "$c" ] && { BACKEND="$c"; break; }
done
for c in "$HOME/.local/share/musicplayer/main.qml" /usr/share/hifi4linux/main.qml; do
    [ -r "$c" ] && { FRONTEND="$c"; break; }
done

[ -n "$BACKEND"  ] || { echo "错误：找不到 musicd.py（本地或系统路径都没有）" >&2; exit 1; }
[ -n "$FRONTEND" ] || { echo "错误：找不到 main.qml（本地或系统路径都没有）" >&2; exit 1; }

LOG="${XDG_RUNTIME_DIR:-/tmp}/musicd.log"

# 后端未运行则启动
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/musicd.pid"
if ! { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }; then
    setsid python3 "$BACKEND" >"$LOG" 2>&1 &
    for _ in $(seq 1 30); do
        curl -s -o /dev/null "http://127.0.0.1:8787/state" && break
        sleep 0.2
    done
fi

exec qml6 "$FRONTEND"
